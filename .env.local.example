# Copy this file to .env.local and fill in the values from your Google Form.
#
# 1. Create a Google Form with these short-answer / yes-no questions, in order:
#       - Name              (short answer, required)
#       - Mobile number     (short answer, required)
#       - Ami artist        (multiple choice: Yes / No)    -- optional
#       - From Kolkata      (multiple choice: Yes / No)    -- optional
# 2. Open the live form URL (https://docs.google.com/forms/d/e/<ID>/viewform).
#    The <ID> portion goes into GOOGLE_FORM_ID below.
# 3. In the live form, right-click -> "View page source" and search for `entry.`.
#    Each field has its own numeric id. Match them to the variables below.
# 4. Generate a random string for CAPTCHA_SECRET (any long random value; this
#    signs the math-captcha tokens so they cannot be forged).

GOOGLE_FORM_ID=
GOOGLE_FORM_ENTRY_NAME=entry.
GOOGLE_FORM_ENTRY_PHONE=entry.

# Optional — leave blank if you did not add these questions to your Google Form
GOOGLE_FORM_ENTRY_ARTIST=
GOOGLE_FORM_ENTRY_KOLKATA=

# Required for the bot-check on the membership form
CAPTCHA_SECRET=change-me-to-a-long-random-string
